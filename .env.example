# =============================================================================
# Alpha AI — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only keys needed for the current phase are required; the rest can stay empty.
# =============================================================================

# --- App ----------------------------------------------------------------------
APP_NAME="Alpha AI"
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Phase 2) ---------------------------------------------------------
# Local (docker-compose) default; in production use the Supabase/Render URL.
POSTGRES_USER=alpha
POSTGRES_PASSWORD=alpha            # CHANGE in any shared environment
POSTGRES_DB=alpha_ai
DATABASE_URL=postgresql+asyncpg://alpha:alpha@localhost:5432/alpha_ai

# --- Supabase (Phase 2 — from your Supabase project settings) -------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-side only; never expose to browsers

# --- Twilio (Phase 4 — from console.twilio.com) ---------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# --- OpenAI (Phase 5 — from platform.openai.com) --------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Redis (optional — async queue, Phase 8+) -----------------------------------
REDIS_URL=

# --- Observability (Phase 10) ----------------------------------------------------
SENTRY_DSN=
