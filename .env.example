# =============================================================================
# Alpha AI — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only keys needed for the current phase are required; the rest can stay empty.
# =============================================================================

# --- App ----------------------------------------------------------------------
APP_NAME="Alpha AI"
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Phase 2) ---------------------------------------------------------
# Runtime role (alpha_app): least privilege, subject to Row Level Security.
# Admin role (owner/superuser): migrations + seeding only. Never use at runtime.
# Local (docker-compose) defaults; in production use the Supabase/Render URLs.
POSTGRES_USER=alpha
POSTGRES_PASSWORD=alpha            # CHANGE in any shared environment
POSTGRES_DB=alpha_ai
APP_DB_PASSWORD=alpha_app          # password of the runtime alpha_app role

# Backend runtime connection (RLS-bound role)
DATABASE_URL=postgresql+asyncpg://alpha_app:alpha_app@localhost:5432/alpha_ai
# Migrations / seed connection (owner role) — used by `python -m app.db.migrate`
ADMIN_DATABASE_URL=postgresql://alpha:alpha@localhost:5432/alpha_ai

# --- Supabase (Phase 2 — from your Supabase project settings) -------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-side only; never expose to browsers
# Supabase Auth JWT secret ("legacy" secret in dashboard → settings → API).
# Required in production: dashboard API auth verifies Supabase tokens with it.
SUPABASE_JWT_SECRET=
# Dev-only token secret used when SUPABASE_JWT_SECRET is absent (>= 32 chars).
# Tests and local tooling mint tokens with this (app.core.auth.issue_dev_token).
AUTH_DEV_SECRET=

# --- Twilio (Phase 4 — from console.twilio.com) ---------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# Full public webhook URL if Twilio sees a different URL than the app does
# (reverse proxies / tunnels). Leave empty unless behind a proxy.
TWILIO_WEBHOOK_URL=
# Shared-number fallback: organizations are routed by their own Twilio numbers
# (organizations.twilio_*_from); numbers not matching any org land here.
DEFAULT_ORGANIZATION_SLUG=

# --- OpenAI (Phase 5 — from platform.openai.com) --------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override for Azure/OpenRouter/proxies; default is OpenAI's public API.
OPENAI_BASE_URL=https://api.openai.com/v1
# Conversation memory: most recent N messages included in prompts.
AI_HISTORY_WINDOW=20
# Lead qualification thresholds (plan defaults: 80 hot / 50 warm).
SCORE_THRESHOLD_HOT=80
SCORE_THRESHOLD_WARM=50

# --- Redis (optional — async queue, Phase 8+) -----------------------------------
REDIS_URL=

# --- Observability (Phase 10) ----------------------------------------------------
SENTRY_DSN=
